# ---- Server ----
PORT=5000
NODE_ENV=production
SERVER_URL=https://api.example.ir

# ---- MySQL (در cPanel نام دیتابیس و کاربر معمولا پیشوند دارند: cpuser_dbname) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# فقط بار اول لازم است؛ جدول‌های موجود را تغییر نمی‌دهد. برای خاموش کردن: false
DB_SYNC=true

# ---- Auth ----
ACCESS_TOKEN_SECRET_KEY=
REFRESH_TOKEN_SECRET_KEY=
COOKIE_PARSER_SECRET_KEY=
# دامنه مشترک کوکی (مثلا .example.ir) یا خالی
DOMAIN=

# ---- CORS: دقیقا آدرس فرانت، با https و بدون اسلش آخر ----
ALLOW_CORS_ORIGIN=https://example.ir

# ---- SMS ----
KAVENEGAR_API_KEY=
# در production حتما false باشد (true یعنی کد OTP داخل پاسخ API برمی‌گردد)
IS_TESTING_MODE_OTP=false
